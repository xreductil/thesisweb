{
  "builds": [
    { "src": "server.py", "use": "@vercel/python" }
  ],
  "routes": [
    {
      "src": "^/(.*\\.(png|jpg|jpeg|svg|css|js))$",
      "dest": "/$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "server.py"
    },
    {
      "src": "^/(.*)$",
      "dest": "server.py"
    }
  ]
}
